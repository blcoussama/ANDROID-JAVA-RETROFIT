<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 et moins : aucune donnée de l'application n'est sauvegardée
     (la session contient un jeton d'authentification). -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
</full-backup-content>
