<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permission Internet (OBLIGATOIRE pour Retrofit) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CabinetMedical"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!-- SplashActivity - LAUNCHER (premier écran) -->
        <activity
            android:name=".ui.auth.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.AppCompat.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- MainActivity - Écran d'erreur fallback pour rôle inconnu -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- LoginActivity -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false" />

        <!-- RegisterActivity -->
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false" />

        <!-- HomePatientActivity - Écran d'accueil du PATIENT -->
        <activity
            android:name=".ui.patient.HomePatientActivity"
            android:exported="false" />

        <!-- DoctorListActivity - Liste des médecins (PATIENT) -->
        <activity
            android:name=".ui.patient.DoctorListActivity"
            android:exported="false"
            android:parentActivityName=".ui.patient.HomePatientActivity" />

        <!-- AvailableTimeSlotsActivity - Créneaux disponibles pour un médecin (PATIENT) -->
        <activity
            android:name=".ui.patient.AvailableTimeSlotsActivity"
            android:exported="false"
            android:parentActivityName=".ui.patient.DoctorListActivity" />

        <!-- BookAppointmentActivity - Prendre RDV (PATIENT) -->
        <activity
            android:name=".ui.patient.BookAppointmentActivity"
            android:exported="false"
            android:parentActivityName=".ui.patient.AvailableTimeSlotsActivity" />

        <!-- MyAppointmentsActivity - Historique RDV (PATIENT) -->
        <activity
            android:name=".ui.patient.MyAppointmentsActivity"
            android:exported="false"
            android:parentActivityName=".ui.patient.HomePatientActivity" />

        <!-- HomeDoctorActivity - Écran d'accueil du DOCTOR -->
        <activity
            android:name=".ui.doctor.HomeDoctorActivity"
            android:exported="false" />

        <!-- DoctorAppointmentsActivity - Liste des RDV du docteur (DOCTOR) -->
        <activity
            android:name=".ui.doctor.DoctorAppointmentsActivity"
            android:exported="false"
            android:parentActivityName=".ui.doctor.HomeDoctorActivity" />

        <!-- DoctorTimeSlotsActivity - Gestion de ses créneaux (DOCTOR) -->
        <activity
            android:name=".ui.doctor.DoctorTimeSlotsActivity"
            android:exported="false"
            android:label="Mes créneaux horaires"
            android:parentActivityName=".ui.doctor.HomeDoctorActivity" />

        <!-- DoctorAddTimeSlotActivity - Ajouter un créneau (DOCTOR) -->
        <activity
            android:name=".ui.doctor.DoctorAddTimeSlotActivity"
            android:exported="false"
            android:label="Ajouter un créneau"
            android:parentActivityName=".ui.doctor.DoctorTimeSlotsActivity" />

        <!-- DoctorEditTimeSlotActivity - Modifier un créneau (DOCTOR) -->
        <activity
            android:name=".ui.doctor.DoctorEditTimeSlotActivity"
            android:exported="false"
            android:label="Modifier le créneau"
            android:parentActivityName=".ui.doctor.DoctorTimeSlotsActivity" />

        <!-- DashboardAdminActivity - Tableau de bord du ADMIN -->
        <activity
            android:name=".ui.admin.DashboardAdminActivity"
            android:exported="false" />

        <!-- AdminDoctorsListActivity - Liste de médecins (ADMIN) -->
        <activity
            android:name=".ui.admin.AdminDoctorsListActivity"
            android:exported="false"
            android:parentActivityName=".ui.admin.DashboardAdminActivity" />

        <!-- AdminDoctorDetailsActivity - Détails d'un médecin (ADMIN) -->
        <activity
            android:name=".ui.admin.AdminDoctorDetailsActivity"
            android:exported="false"
            android:parentActivityName=".ui.admin.AdminDoctorsListActivity" />

        <!-- AdminAddDoctorActivity - Ajouter un médecin (ADMIN) -->
        <activity
            android:name=".ui.admin.AdminAddDoctorActivity"
            android:exported="false"
            android:parentActivityName=".ui.admin.AdminDoctorsListActivity" />

        <!-- AdminEditDoctorActivity - Modifier un médecin (ADMIN) -->
        <activity
            android:name=".ui.admin.AdminEditDoctorActivity"
            android:exported="false"
            android:parentActivityName=".ui.admin.AdminDoctorDetailsActivity" />

        <!-- AdminPatientsListActivity - Liste des patients (ADMIN) -->
        <activity
            android:name=".ui.admin.AdminPatientsListActivity"
            android:exported="false"
            android:label="Gestion des patients"
            android:parentActivityName=".ui.admin.DashboardAdminActivity" />

        <!-- AdminPatientDetailsActivity - Détails d'un patient (ADMIN) -->
        <activity
            android:name=".ui.admin.AdminPatientDetailsActivity"
            android:exported="false"
            android:label="Détails du patient"
            android:parentActivityName=".ui.admin.AdminPatientsListActivity" />

        <!-- AdminAddPatientActivity - Ajouter un patient (ADMIN) -->
        <activity
            android:name=".ui.admin.AdminAddPatientActivity"
            android:exported="false"
            android:label="Ajouter un patient"
            android:parentActivityName=".ui.admin.AdminPatientsListActivity" />

        <!-- AdminEditPatientActivity - Modifier un patient (ADMIN) -->
        <activity
            android:name=".ui.admin.AdminEditPatientActivity"
            android:exported="false"
            android:label="Modifier le patient"
            android:parentActivityName=".ui.admin.AdminPatientDetailsActivity" />

        <!-- AdminAllAppointmentsActivity - Voir et Gerer Tous les RDV (ADMIN) -->
        <activity
            android:name=".ui.admin.AdminAllAppointmentsActivity"
            android:exported="false"
            android:label="Tous les rendez-vous"
            android:parentActivityName=".ui.admin.DashboardAdminActivity" />

    </application>

</manifest>
